---
import Button from "../components/button.astro";
import Layout from "../layouts/main.astro";
---

<Layout title="Bhavesh Sonar">
  <div class="flex flex-col min-h-[calc(100vh-200px)]">
    <div
      class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0 flex-1"
    >
      <div class="flex flex-col items-center md:flex-row">
        <div class="relative w-full md:w-1/2">
          <h1
            class="mb-5 text-4xl font-bold leading-tight md:text-4xl lg:text-6xl dark:text-white"
          >
            Hello, I'm Bhavesh.
          </h1>
          <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
            I'm a Software Engineer based in Pune, India. <br
              class="hidden lg:block"
            />Passionate about Full Stack Development and Problem Solving.
          </p>

          <div class="py-2 space-y-2">
            <p class="section-description">
              Know more
              <a class="ml-2 font-normal text-black" href="/pages/about.html">
                <Button text="About Me" link="/about" />
              </a>
              <span class="ml-1">and</span>
              <a class="ml-1 mr-2 font-normal text-black" href="/pages/projects.html">
                <Button text="My Work" link="/projects" />  
              </a>
            </p>
          </div>
        </div>
        <div
          class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
        >
        </div>
      </div>
    </div>

  </div>
</Layout>
